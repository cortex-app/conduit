# Copy to .env and adjust.

# The URL to the Phabricator or Phorge API. Trailing slash is required.
PHABRICATOR_URL=https://your-phabricator-instance.com/api/

# Optional host port for this Compose service (MCP SSE); defaults to 8000.
# CONDUIT_MCP_HOST_PORT=9000

# Optional SOCKS proxy for outbound API calls from the container.
# PHABRICATOR_PROXY=socks5://host.docker.internal:1080

# Optional possibility to disable certificate verification, in case you use a self-signed certificate.
# PHABRICATOR_DISABLE_CERT_VERIFY=0
